generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// 1. PENGGUNA & HAK AKSES
// ==========================================
model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  nama     String
  no_hp    String  @unique
  password String
  role     Role
  isActive Boolean @default(true) @map("is_active")

  // Back-relations
  leads               Lead[]              @relation("MarketingLeads")
  transaksi           Transaksi[]         @relation("PicTransaksi")
  pembayaran_diterima Pembayaran[]        @relation("AdminPenerima")
  itj_diajukan        Itj[]               @relation("ItjCloser")
  transaksi_logs      TransaksiTahapLog[] @relation("ActorTransaksiLog")
  aktivitas_log       Aktivitas[]         @relation("UserAktivitas")
  pembayaran_divoid   Pembayaran[]        @relation("AdminVoider")
  pengajuan_kpr_logs  PengajuanKPRLog[]   @relation("ActorPengajuanKPRLog")
  unit_tipe_logs      UnitTipeLog[]       @relation("ActorTipeLog")
  activity_logs       ActivityLog[]       @relation("ActivityActor")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum Role {
  MARKETING
  ADMIN
  MANAGER
}

// ==========================================
// 2. MASTER DATA (PRODUK & INVENTORI)
// ==========================================
model MasterTipe {
  id             Int           @id @default(autoincrement())
  nama_tipe      String
  kategori       KategoriUnit
  luas_bangunan  Int?
  luas_tanah     Int
  harga_dasar    Decimal       @db.Decimal(15, 2)
  units          MasterUnit[]
  unit_tipe_lama UnitTipeLog[] @relation("TipeLama")
  unit_tipe_baru UnitTipeLog[] @relation("TipeBaru")

  @@unique([kategori, luas_bangunan, luas_tanah])
}

model MasterUnit {
  id           Int        @id @default(autoincrement())
  tipe_id      Int
  blok         String     @unique
  blok_prefix  String     @default("")
  blok_nomor   Int        @default(0)
  status_unit  StatusUnit @default(AVAILABLE)
  harga_khusus Decimal?   @db.Decimal(15, 2)

  tipe             MasterTipe    @relation(fields: [tipe_id], references: [id])
  transaksi        Transaksi[]   @relation("UnitTransaksi")
  active_transaksi Transaksi?    @relation("ActiveUnitTransaksi")
  itj              Itj[]
  tipe_logs        UnitTipeLog[]

  @@index([status_unit])
}

model UnitTipeLog {
  id                   Int      @id @default(autoincrement())
  unit_id              Int?
  blok                 String
  tipe_lama_id         Int
  tipe_baru_id         Int
  harga_khusus_lama    Decimal? @db.Decimal(15, 2)
  harga_khusus_direset Boolean  @default(false)
  alasan               String   @db.Text
  actor_id             Int      @map("actor_id")
  created_at           DateTime @default(now())

  unit      MasterUnit? @relation(fields: [unit_id], references: [id], onDelete: SetNull)
  tipe_lama MasterTipe  @relation("TipeLama", fields: [tipe_lama_id], references: [id])
  tipe_baru MasterTipe  @relation("TipeBaru", fields: [tipe_baru_id], references: [id])
  actor     User        @relation("ActorTipeLog", fields: [actor_id], references: [id])

  @@index([unit_id, created_at])
  @@index([blok])
}

enum KategoriUnit {
  SUBSIDI
  KOMERSIL
  KAVLING
}

enum StatusUnit {
  AVAILABLE
  HOLD
  BOOKED
  SOLD
}

// ==========================================
// 3. LEAD & AKTIVITAS
// ==========================================
enum SumberLead {
  WALK_IN
  FACEBOOK_ADS
  TIKTOK
  INSTAGRAM
  WA_KANTOR
  REFERRAL
  LAINNYA
}

model Lead {
  id           Int        @id @default(autoincrement())
  marketing_id Int?
  customer_id  Int?
  nama         String
  no_hp        String?
  sumber       SumberLead @default(LAINNYA)
  minat_tipe   String?

  // Milestone Dates (tahap lead DITURUNKAN dari kolom-kolom ini, bukan status manual)
  survei_jadwal_at  DateTime?
  survei_selesai_at DateTime?
  lost_at           DateTime?
  lost_reason       String?   @db.Text

  // CHANGED: kolom turunan untuk dashboard marketing.
  // Wajib diperbarui di transaksi DB yang sama saat Aktivitas dibuat.
  last_activity_at  DateTime? // created_at aktivitas terbaru
  next_follow_up_at DateTime? // tgl_follow_up milik aktivitas terbaru (null = tidak ada jadwal)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  marketing User?       @relation("MarketingLeads", fields: [marketing_id], references: [id])
  customer  Customer?   @relation("CustomerLeads", fields: [customer_id], references: [id])
  aktivitas     Aktivitas[]
  itj           Itj[]
  activity_logs ActivityLog[]

  @@index([no_hp])
  @@index([marketing_id, created_at])
  @@index([marketing_id, next_follow_up_at]) // CHANGED
  @@index([sumber])
  @@index([survei_jadwal_at]) // CHANGED
  @@index([survei_selesai_at]) // CHANGED
}

model Aktivitas {
  id            Int            @id @default(autoincrement())
  lead_id       Int
  user_id       Int
  jenis         JenisAktivitas
  hasil         HasilAktivitas
  catatan       String?        @db.Text
  tgl_follow_up DateTime?

  created_at DateTime @default(now())

  lead Lead @relation(fields: [lead_id], references: [id], onDelete: Restrict)
  user User @relation("UserAktivitas", fields: [user_id], references: [id])

  @@index([lead_id, tgl_follow_up])
  @@index([user_id])
}

enum JenisAktivitas {
  TELEPON
  WHATSAPP
  BERTEMU
  LAINNYA
}

enum HasilAktivitas {
  TERTARIK
  MASIH_MIKIR
  TIDAK_DIJAWAB
  MINTA_INFO_LAGI
  TIDAK_JADI
}

// ==========================================
// 4. ITJ WORKFLOW (Closing Langsung)
// ==========================================
model Itj {
  id           Int         @id @default(autoincrement())
  lead_id      Int
  unit_id      Int
  closer_id    Int?        @map("closer_id") // Pemilik closing (snapshot marketing saat ITJ dibuat)
  nik          String
  nama_ktp     String
  nominal      Decimal     @default(0) @db.Decimal(15, 2)
  metode_bayar MetodeBayar
  tenor        Int?
  diajukan_at  DateTime    @default(now())

  lead      Lead       @relation(fields: [lead_id], references: [id], onDelete: Restrict)
  unit      MasterUnit @relation(fields: [unit_id], references: [id])
  closer    User?      @relation("ItjCloser", fields: [closer_id], references: [id])
  transaksi Transaksi?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([unit_id])
  @@index([closer_id, diajukan_at])
}

// ==========================================
// 5. CUSTOMER & TRANSAKSI
// ==========================================
model Customer {
  id                Int               @id @default(autoincrement())
  nama_ktp          String
  nik               String            @unique
  tempat_lahir      String
  tgl_lahir         DateTime          @db.Date // CHANGED: tanggal murni
  alamat_ktp        String            @db.Text
  no_hp             String?
  status_pernikahan StatusPernikahan?
  status_pekerjaan  StatusPekerjaan?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  transaksi Transaksi[]
  leads     Lead[]      @relation("CustomerLeads")
}

enum StatusPernikahan {
  MENIKAH
  BELUM_MENIKAH
  CERAI
}

enum StatusPekerjaan {
  TETAP
  TIDAK_TETAP
}

enum MetodeBayar {
  KPR
  CASH_KERAS
  CASH_TEMPO
}

// STATUS MIKRO (Sesuai Metode Bayar)
// Pemetaan detail -> makro diturunkan lewat lib/transaksi/stage-map.ts
enum TahapDetail {
  PENGUMPULAN_DOKUMEN
  PROSES_BANK
  // KPR
  AKAD_KREDIT
  // Cash Keras
  PEMBERKASAN_LEGALITAS
  MENUNGGU_PELUNASAN
  // Cash Tempo
  PEMBERKASAN_PPJB
  PEMBAYARAN_DP
  CICILAN_BERJALAN
  PELUNASAN
  // Bersama
  AJB
  BAST
  BATAL
}

model Transaksi {
  id           Int @id @default(autoincrement())
  customer_id  Int
  unit_id      Int
  pic_id       Int @map("pic_id") // PIC operasional saat ini
  itj_id       Int @unique

  metode_bayar MetodeBayar
  harga_deal   Decimal     @db.Decimal(15, 2)
  target_itj   Decimal     @db.Decimal(15, 2)
  target_dp    Decimal     @db.Decimal(15, 2)
  tenor_bulan  Int?

  tahap_detail TahapDetail
  tahap_since  DateTime    @default(now())

  nama_notaris String?

  // RENCANA MILESTONES (Boleh di masa depan, boleh diedit)
  rencana_akad_at DateTime? @db.Date
  rencana_bast_at DateTime? @db.Date

  // OPERATIONAL MILESTONES AKTUAL (<= hari ini, tanggal kejadian nyata)
  tgl_akad DateTime? @db.Date
  lunas_at DateTime? @db.Date
  tgl_bast DateTime? @db.Date

  // REPORTING MILESTONES (SSOT)
  closing_at    DateTime  @db.Date // Wajib, tanggal ITJ saat transaksi dibuat, tidak pernah diubah
  cancelled_at  DateTime?
  alasan_batal  String?   @db.Text
  catatan_admin String?   @db.Text

  // CONCURRENCY & INTEGRITY
  version                   Int  @default(0)
  active_unit_id            Int? @unique
  pengajuan_kpr_terpilih_id Int? @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer               Customer            @relation(fields: [customer_id], references: [id])
  unit                   MasterUnit          @relation("UnitTransaksi", fields: [unit_id], references: [id])
  active_unit            MasterUnit?         @relation("ActiveUnitTransaksi", fields: [active_unit_id], references: [id])
  pic                    User                @relation("PicTransaksi", fields: [pic_id], references: [id])
  itj                    Itj                 @relation(fields: [itj_id], references: [id])
  pembayaran             Pembayaran[]
  logs                   TransaksiTahapLog[]
  dokumen                DokumenTransaksi[]
  checklist_bast         ChecklistBAST[]
  pengajuan_kpr          PengajuanKPR[]      @relation("TransaksiPengajuanKPR")
  pengajuan_kpr_terpilih PengajuanKPR?       @relation("PengajuanKPRTerpilih", fields: [pengajuan_kpr_terpilih_id], references: [id])
  activity_logs          ActivityLog[]

  @@index([tahap_detail, updated_at])
  @@index([tahap_detail, rencana_akad_at])
  @@index([tahap_detail, rencana_bast_at])
  @@index([closing_at])
  @@index([pic_id, tahap_detail])
}

// ==========================================
// 6. PENGAJUAN KPR & BANK
// ==========================================
model Bank {
  id         Int      @id @default(autoincrement())
  nama       String   @unique
  kode       String?  @unique
  is_active  Boolean  @default(true)
  catatan    String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pengajuan_kpr PengajuanKPR[]
}

enum StatusPengajuanKPR {
  DIAJUKAN
  WAWANCARA
  OTS
  VERIFIKASI
  SP3K
  // DISETUJUI
  DITOLAK
  DIBATALKAN
}

model PengajuanKPR {
  id                Int                @id @default(autoincrement())
  transaksi_id      Int
  bank_id           Int
  nomor_pengajuan   Int
  status            StatusPengajuanKPR @default(DIAJUKAN)
  tanggal_ajukan    DateTime           @default(now())
  tanggal_keputusan DateTime?
  alasan_penolakan  String?            @db.Text
  catatan           String?            @db.Text
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  transaksi          Transaksi         @relation("TransaksiPengajuanKPR", fields: [transaksi_id], references: [id], onDelete: Restrict)
  transaksi_terpilih Transaksi?        @relation("PengajuanKPRTerpilih")
  bank               Bank              @relation(fields: [bank_id], references: [id], onDelete: Restrict)
  logs               PengajuanKPRLog[]

  @@unique([transaksi_id, nomor_pengajuan])
  @@index([transaksi_id, status])
  @@index([bank_id, status])
}

model PengajuanKPRLog {
  id             Int                 @id @default(autoincrement())
  pengajuan_id   Int
  status_sebelum StatusPengajuanKPR?
  status_sesudah StatusPengajuanKPR
  actor_id       Int                 @map("actor_id")
  catatan        String?             @db.Text
  created_at     DateTime            @default(now())

  pengajuan PengajuanKPR @relation(fields: [pengajuan_id], references: [id], onDelete: Restrict)
  actor     User         @relation("ActorPengajuanKPRLog", fields: [actor_id], references: [id], onDelete: Restrict)

  @@index([pengajuan_id, created_at])
  @@index([actor_id, created_at])
}

// ==========================================
// 7. MANAJEMEN DOKUMEN & AUDIT LOG
// ==========================================
model TransaksiTahapLog {
  id             Int          @id @default(autoincrement())
  transaksi_id   Int
  detail_sebelum TahapDetail?
  detail_sesudah TahapDetail
  actor_id       Int          @map("actor_id")
  catatan        String?      @db.Text
  created_at     DateTime     @default(now())

  transaksi Transaksi @relation(fields: [transaksi_id], references: [id], onDelete: Restrict)
  actor     User      @relation("ActorTransaksiLog", fields: [actor_id], references: [id])

  @@index([transaksi_id, created_at])
}

enum JenisDokumen {
  KTP_SUAMI_ISTRI // DEPRECATED: digantikan KTP_PEMOHON & KTP_PASANGAN
  KTP_PEMOHON
  KTP_PASANGAN
  KARTU_KELUARGA
  NPWP
  BUKU_NIKAH
  SURAT_PERNYATAAN_BELUM_MENIKAH
  AKTA_CERAI
  SLIP_GAJI
  SURAT_KET_KERJA
  REKENING_KORAN
  SURAT_KET_BELUM_PUNYA_RUMAH
  SKU_WIRAUSAHA
  LAPORAN_KEUANGAN
  LEGALITAS_LAINNYA
  FORM_APLIKASI_KPR
  FORM_FPPA
  PAS_FOTO
  FOTO_TEMPAT_USAHA
  DENAH_LOKASI_USAHA
  FOTO_LOKASI_KERJA
  DENAH_LOKASI_KERJA
  BUKU_TABUNGAN_BTN
  REKENING_KORAN_USAHA_6BLN
  SPT_TAHUNAN
  SURAT_PENAWARAN_RUMAH
  SURAT_LUNAS_UANG_MUKA
  BROSUR_SITEPLAN
  SERTIFIKAT_IMB
}

enum StatusDokumen {
  BELUM_LENGKAP
  LENGKAP
}

model DokumenTransaksi {
  id           Int           @id @default(autoincrement())
  transaksi_id Int
  jenis        JenisDokumen
  status       StatusDokumen @default(BELUM_LENGKAP)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  transaksi Transaksi @relation(fields: [transaksi_id], references: [id], onDelete: Restrict)

  @@unique([transaksi_id, jenis])
  @@index([transaksi_id])
}

// ==========================================
// 8. CHECKLIST BAST (SERAH TERIMA UNIT)
// ==========================================
enum ItemBAST {
  PONDASI_STRUKTUR
  DINDING_PLESTER_CAT
  ATAP_PLAFON
  LANTAI_KERAMIK
  KUSEN_PINTU_JENDELA
  KELISTRIKAN
  SANITASI_AIR_POMPA
  FASAD_KEBERSIHAN
}

enum StatusBAST {
  BELUM_LENGKAP
  LENGKAP
}

model ChecklistBAST {
  id           Int        @id @default(autoincrement())
  transaksi_id Int
  item         ItemBAST
  status       StatusBAST @default(BELUM_LENGKAP)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  transaksi Transaksi @relation(fields: [transaksi_id], references: [id], onDelete: Cascade)

  @@unique([transaksi_id, item])
  @@index([transaksi_id])
}

// ==========================================
// 9. KEUANGAN & AUDIT VOID
// ==========================================
enum JenisBayar {
  ITJ
  DP
  CICILAN
  PELUNASAN
}

enum CaraBayar {
  TUNAI
  TRANSFER
}

model Pembayaran {
  id               Int        @id @default(autoincrement())
  transaksi_id     Int
  admin_id         Int
  no_kwitansi      String     @unique
  jenis_pembayaran JenisBayar
  cara_bayar       CaraBayar  @default(TRANSFER)
  nominal          Decimal    @db.Decimal(15, 2)
  tgl_bayar        DateTime   @db.Date // CHANGED: tanggal murni; laporan kas memakai kolom ini, bukan created_at
  catatan          String?    @db.Text

  is_void     Boolean   @default(false)
  void_at     DateTime?
  void_by     Int?
  void_reason String?   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  transaksi Transaksi @relation(fields: [transaksi_id], references: [id], onDelete: Restrict)
  penerima  User      @relation("AdminPenerima", fields: [admin_id], references: [id])
  voider    User?     @relation("AdminVoider", fields: [void_by], references: [id])

  @@index([transaksi_id, tgl_bayar])
  @@index([is_void, tgl_bayar]) // CHANGED: laporan kas (selalu is_void = false)
}

// ==========================================
// 10. UNIFIED AUDIT LOG (ACTIVITY LOG)
// ==========================================
enum ActivityEntity {
  LEAD
  TRANSAKSI
  DOKUMEN
  BAST_ITEM
  PEMBAYARAN
  PENGAJUAN_KPR
  UNIT
}

model ActivityLog {
  id           Int            @id @default(autoincrement())
  entity_type  ActivityEntity
  entity_id    Int
  action       String         @db.VarChar(48) // nilai dibatasi union TypeScript ACTIVITY_ACTIONS (lib/activity/actions.ts) + zod
  lead_id      Int?
  transaksi_id Int?
  tahap_detail TahapDetail?   // tahap transaksi SAAT kejadian
  actor_id     Int?           // null = sistem
  summary      String         @db.Text // kalimat Indonesia siap tampil, dibuat saat penulisan
  before       Json?
  after        Json?
  is_backfill  Boolean        @default(false)
  created_at   DateTime       @default(now())

  actor     User?      @relation("ActivityActor", fields: [actor_id], references: [id], onDelete: Restrict)
  lead      Lead?      @relation(fields: [lead_id], references: [id], onDelete: Restrict)
  transaksi Transaksi? @relation(fields: [transaksi_id], references: [id], onDelete: Restrict)

  @@index([transaksi_id, created_at])
  @@index([lead_id, created_at])
  @@index([actor_id, created_at])
  @@index([action, created_at])
  @@index([entity_type, created_at])
  @@index([created_at])
}

